{
  "name": "@shuji-bonji/rxjs-mcp",
  "version": "0.5.2",
  "description": "RxJS MCP Server - Execute, debug, and visualize RxJS streams for AI assistants",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "rxjs",
    "reactive",
    "observable",
    "stream",
    "angular",
    "claude",
    "ai-assistant",
    "debugging",
    "marble-diagram"
  ],
  "author": "Shuji Bonji",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "rxjs-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.ja.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mcp": "node test-mcp-server.mjs",
    "test:integration": "vitest run src/tools/mcp-integration.test.ts",
    "test:inspector": "npx @modelcontextprotocol/inspector dist/index.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "clean": "rm -rf dist",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "rxjs": "^7.8.2",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "eslint-plugin-rxjs-x": "^1.0.6",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shuji-bonji/rxjs-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/shuji-bonji/rxjs-mcp-server/issues"
  },
  "homepage": "https://github.com/shuji-bonji/rxjs-mcp-server#readme",
  "publishConfig": {
    "access": "public"
  }
}
